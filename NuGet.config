<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local stand-in for the real feed until SearchUtilities is actually published.
         Once `dotnet nuget push` has been run for real, this source (and eventually this
         whole file) can go away - nuget.org will resolve the package on its own. -->
    <add key="search-utilities-local" value="../search-utilities/nupkg" />
  </packageSources>
</configuration>
